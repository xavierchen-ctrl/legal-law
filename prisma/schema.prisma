// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Contract {
  id                 String    @id @default(uuid())
  contractNumber     String    @unique // e.g., W250001
  requestDate        DateTime  @default(now())
  department         String
  requester          String
  requesterEmail     String?
  counterparty       String
  documentName       String
  paymentTerms       String?
  financialTerms     String?
  
  // Status & Priority
  priority           Priority  @default(NORMAL)
  status             Status    @default(SUBMITTED)
  
  // Tracking Dates
  estimatedReplyDate DateTime?
  replyDates         String?   // JSON string storing date history
  closeDate          DateTime?
  closeReason        String?
  
  // Archiving
  archivedPhysical   Boolean   @default(false)
  archivedDigital    Boolean   @default(false)
  
  // Automation
  notificationSent   Boolean   @default(false)
  
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

enum Priority {
  NORMAL
  URGENT
}

enum Status {
  SUBMITTED         // 申請中
  IN_REVIEW         // 法務審閱中
  AWAITING_FEEDBACK // 待需求單位回覆
  PAUSED            // 暫停中
  CLOSED            // 已結案
}

// ── 合約進度追蹤（疊加於 Google Sheets 資料之上）──
model ContractTracking {
  id                    Int            @id @default(autoincrement())
  contractNumber        String         @unique  // 對應 Google Sheets 的合約編號

  trackingStatus        TrackingStatus @default(REVIEWING)

  // 各階段時間戳（切換狀態時由系統自動記錄）
  reviewingAt           DateTime?
  repliedAt             DateTime?
  stampRequestedAt      DateTime?
  archivedAt            DateTime?

  // 歸檔通知名單：JSON 字串 [{name, email}]
  archiveNotifyEmails   String?
  lastArchiveReminderAt DateTime?

  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
}

enum TrackingStatus {
  REVIEWING     // 審閱中
  REPLIED       // 已回覆
  PENDING_STAMP // 待用印
  ARCHIVED      // 已歸檔
}
